{
  "name": "warzone-0g-backend",
  "version": "1.0.0",
  "description": "WarzoneWarrior game backend with 0G decentralized storage, DA, chain anchoring, and compute anti-cheat",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "compile:contracts": "npx hardhat compile",
    "deploy:anchor": "npx hardhat run scripts/deploy.js --network 0g-mainnet",
    "deploy:anchor:testnet": "npx hardhat run scripts/deploy.js --network 0g-newton",
    "transfer-ownership": "node scripts/transfer-ownership.mjs",
    "verify-helper": "node scripts/verify-helper.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "6.13.1",
    "ethers-v6": "npm:ethers@6.13.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.5.2",
    "express-rate-limit": "^7.4.0",
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.9",
    "@grpc/grpc-js": "^1.11.1",
    "@grpc/proto-loader": "^0.7.13",
    "@msgpack/msgpack": "^3.0.0",
    "@tensorflow/tfjs": "^4.15.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "hardhat": "^2.22.0",
    "@nomicfoundation/hardhat-ethers": "3.0.6"
  }
}
