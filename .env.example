# ─── Warzone Warriors Backend — Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── App ────────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
MONGO_DB_NAME=warzone-0g
JWT_SECRET=<long-random-string-min-32-chars>
PORT=3300
NODE_ENV=production

# ── 0G EVM Mainnet (chainId 16661) ────────────────────────────────────────────
ZG_RPC_URL=https://evmrpc.0g.ai
ZG_CHAIN_ID=16661
ZG_ANCHOR_CONTRACT_ADDRESS=0x...   # printed after: node scripts/deployAnchor.js

# Key separation (recommended for production):
#   ZG_STORAGE_PRIVATE_KEY  — wallet used to sign 0G Storage upload transactions
#   ZG_CHAIN_PRIVATE_KEY    — wallet used to call PlayerSaveAnchor.anchorSave()
# If you only have one key, set ZG_PRIVATE_KEY and both services will use it.
ZG_STORAGE_PRIVATE_KEY=0x...      # fund with 0G tokens (storage tx fees)
ZG_CHAIN_PRIVATE_KEY=0x...        # fund with 0G tokens (anchor tx fees)
# ZG_PRIVATE_KEY=0x...            # fallback single key (backward compat)

# ── 0G Storage ────────────────────────────────────────────────────────────────
ZG_INDEXER_RPC=https://indexer-storage-turbo.0g.ai

# ── 0G DA ─────────────────────────────────────────────────────────────────────
ZG_DA_DISPERSER=disperser-testnet.0g.ai:51001
# ZG_DA_TLS=true                   # auto-detected from endpoint name
# ZG_DA_POLL_TIMEOUT_MS=240000     # DA finality poll timeout (default 240s)
# ZG_DA_POLL_INTERVAL_MS=5000      # DA poll interval (default 5s)

# ── 0G Compute (optional) ─────────────────────────────────────────────────────
# ZG_COMPUTE_API_KEY=              # leave blank to skip anti-cheat

# ── Redis (optional — enables shared rate limiting across instances) ───────────
# REDIS_URL=redis://localhost:6379
# Without Redis, in-memory rate limiting is used (suitable for single instance).

# ── Observability ─────────────────────────────────────────────────────────────
# Prometheus metrics are exposed at GET /metrics (prom-client — optional dep).
# Install: npm install prom-client ioredis
# In production, restrict /metrics to internal network via nginx/firewall.

# ── Tuning ────────────────────────────────────────────────────────────────────
ZG_ENABLED=true                    # set false to disable all 0G ops in local dev
TRUST_PROXY=1                      # number of reverse proxy hops (nginx/cloudflare)
SLOW_REQUEST_MS=2000               # log warn for requests slower than this
SLOW_MONGO_MS=200                  # log warn for mongo queries slower than this
# MONGOOSE_DEBUG_LOGS=false        # set true to log all mongo command durations
# API_PERF_LOGS=true               # set false to silence per-step performance logs
# API_SLOW_STEP_MS=500             # log warn for controller steps slower than this
